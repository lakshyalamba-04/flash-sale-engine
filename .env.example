# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=flash_sale_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Reservation TTL (seconds) - 7 minutes
RESERVATION_TTL=420

# Worker
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL=100
